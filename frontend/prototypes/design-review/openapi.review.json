                        "summary",
                        "rows"
                      ],
                      "properties": {
                        "available": {
                          "type": "boolean"
                        },
                        "summary": {
                          "$ref": "#/components/schemas/Metric"
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "完整GdsRouteMetricRow见已有TypeScript契约；不提供航段分母。"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数非法"
          },
          "401": {
            "description": "认证层拒绝时返回；实际策略待核验"
          },
          "403": {
            "description": "权限层拒绝时返回；实际策略待核验"
          },
          "503": {
            "description": "航线查询不可用"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Metric": {
        "type": "object",
        "properties": {
          "searchRequests": {
            "type": "integer",
            "minimum": 0
          },
          "verifyRequests": {
            "type": "integer",
            "minimum": 0
          },
          "orderRequests": {
            "type": "integer",
            "minimum": 0
          },
          "segmentCount": {
            "type": "integer",
            "nullable": true
          },
          "queryToSegmentRatio": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
