        }
      }
    },
    "/v1/resource-governance/gds/routes": {
      "get": {
        "operationId": "api_routes",
        "summary": "航线日汇总",
        "x-design-id": "API-ROUTES",
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "查询范围起点，按业务日期，不等同请求事件时间。"
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "查询范围终点；原页面默认昨日，不假定当天数据完整。"
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "请求所属平台，与站点共同限定范围。"
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "平台下的站点归属，不等于用户配置主体。"
          },
          {
            "name": "gds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "资源系统代码；不等同MP/MPIS通道。"
          },
          {
            "name": "pcc",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "资源账户范围，和平台/站点组合分析。"
          },
          {
            "name": "resourceChannel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "",
                "MP",
                "MPIS"
              ]
            },
            "description": "当前实际资源通道统计维度，不能证明配置本应走哪条。"
          },
          {
            "name": "apiGroup",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "区分接口来源，NDC仍纳入非MPIS查询口径。"
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "现有航线维度，不假定已经与内部配置ID关联。"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "查询已限定范围中的航线或对象，不代替完整配置归属。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功封装；此schema只覆盖评审使用的公共字段",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
