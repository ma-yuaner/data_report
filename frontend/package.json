{
  "name": "data-report-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:product-review": "vue-tsc -p prototypes/product-review/tsconfig.json --noEmit && vite build --config vite.product-review.config.ts",
    "package:product-review": "npm run build:adm-demo && npm run build:product-review && node prototypes/adm-review/package-demo.mjs && node prototypes/product-review/package.mjs",
    "build:adm-demo": "node prototypes/adm-review/generate-system-navigation.mjs && node prototypes/adm-review/generate-prd.mjs && node prototypes/adm-review/live/generate-contract.mjs && node prototypes/resource-review/generate-contract.mjs && vue-tsc -p prototypes/adm-review/tsconfig.json --noEmit && vite build --config vite.adm-prototype.config.ts",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "check:components": "node scripts/check-ant-components.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node --test scripts/*.test.mjs",
    "lint": "eslint src scripts vite.config.ts eslint.config.mjs --max-warnings=0",
    "format:check": "prettier --check src/features/resource-governance eslint.config.mjs package.json .prettierrc.json",
    "format": "prettier --write src/features/resource-governance eslint.config.mjs package.json .prettierrc.json",
    "type-check": "vue-tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.21",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.6"
  }
}
