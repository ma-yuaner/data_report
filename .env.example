APP_ENV=development
SECRET_KEY=replace-me
API_PORT=5160
WEB_PORT=1818
DATA_MODE=mysql
# Docker Hub不可达时可切换为docker.m.daocloud.io；正常公网环境使用docker.io。
DOCKERHUB_MIRROR=docker.io
# 系统业务时间和操作记录统一使用上海时区；MySQL会话固定为UTC+8。
TZ=Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai
MYSQL_TIME_ZONE=+08:00

# 默认读取 MySQL sibebid。连接信息只填写在部署环境，不要提交真实密码。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=sibebid
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=60
MYSQL_WRITE_TIMEOUT=60
# 综合分析ADS全日期范围行数保护（含coverage），最大100万；可回退100000。
COMPREHENSIVE_MAX_ROWS=1000000
COMPREHENSIVE_EXPORT_ROOT=/app/var/comprehensive-exports
COMPREHENSIVE_EXPORT_RETENTION_HOURS=24
# 每个API进程复用MySQL连接，避免登录、切页时反复建立TCP连接。
MYSQL_POOL_SIZE=12
MYSQL_POOL_MIN_CACHED=2
# 花名册可位于独立RDS；未填写连接项时回退到主MySQL连接。
ERP_ROSTER_MYSQL_HOST=
ERP_ROSTER_MYSQL_PORT=3306
ERP_ROSTER_MYSQL_USER=
ERP_ROSTER_MYSQL_PASSWORD=
ERP_ROSTER_MYSQL_CHARSET=utf8mb4
ERP_ROSTER_DATABASE=sibedb
ERP_ROSTER_TABLE=system_user
ERP_ROSTER_USER_TABLE=system_user
ERP_ROSTER_USER_DEPARTMENT_TABLE=system_user_department
ERP_ROSTER_ORG_TABLE=base_organization
# 目标进度ETL只读ERP业务明细；留空时复用上面的sibedb连接。
TARGET_ERP_MYSQL_HOST=
TARGET_ERP_MYSQL_PORT=3306
TARGET_ERP_MYSQL_USER=
TARGET_ERP_MYSQL_PASSWORD=
TARGET_ERP_MYSQL_CHARSET=utf8mb4
TARGET_ERP_DATABASE=sibedb
ERP_PLATFORM_DATABASE=sibelog
ERP_PLATFORM_TABLE=sibe_ota
# 目标进度准实时刷新间隔，默认15分钟；最小60秒。
TARGET_ETL_INTERVAL_SECONDS=900
# 手动“立即更新”的冷却时间，以及等待自动ETL释放并发锁的最长秒数。
TARGET_ETL_MANUAL_COOLDOWN_SECONDS=120
TARGET_ETL_MANUAL_LOCK_WAIT_SECONDS=30
TARGET_ETL_MANUAL_STALE_SECONDS=7200

# ERP花名册可位于另一台MySQL；留空时兼容旧部署并复用上面的MYSQL连接。
ERP_MYSQL_HOST=
ERP_MYSQL_PORT=3306
ERP_MYSQL_DATABASE=sibebd
ERP_MYSQL_USER=
ERP_MYSQL_PASSWORD=
ERP_MYSQL_CHARSET=utf8mb4
ERP_MYSQL_CONNECT_TIMEOUT=10
ERP_MYSQL_READ_TIMEOUT=60
ERP_MYSQL_WRITE_TIMEOUT=60
ERP_MYSQL_POOL_SIZE=4
ERP_MYSQL_POOL_MIN_CACHED=1
PERFORMANCE_SLOW_REQUEST_MS=500
# GDS/OTA资源治理V1阶段目标；后续规则中心上线后改由规则配置表维护。
RESOURCE_GOVERNANCE_GDS_TABLE=bi_gds_resource_metric_day
RESOURCE_GOVERNANCE_GDS_TARGETS=1A:4000
# Optional exact GDS/PCC/platform/site overrides; JSON list, max 100 entries.
RESOURCE_GOVERNANCE_COMBINATION_TARGETS=[]
RESOURCE_GOVERNANCE_OTA_SUCCESS_TARGETS={}
GDS_ROUTE_HIVE_TABLE=dws_gds_airroute_day
GDS_ROUTE_MAX_ROWS=500
GDS_ROUTE_MAX_DAYS=31

# 本地账号认证。账号复用sys_user，安全状态、会话和审计自动建立在sibebid的auth_*表中。
AUTH_ENABLED=true
AUTH_AUTO_CREATE_TABLES=true
AUTH_IDLE_TIMEOUT_SECONDS=14400
AUTH_ABSOLUTE_TIMEOUT_SECONDS=86400
AUTH_SESSION_TOUCH_SECONDS=60
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_COOKIE_NAME=data_report_session
AUTH_CSRF_COOKIE_NAME=data_report_csrf
# 当前HTTP测试环境为false；正式切换HTTPS后改为true。
AUTH_COOKIE_SECURE=false
# 仅sys_user为空时使用。首次登录会强制改密，完成后请从.env删除密码并重启。
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# MySQL 临时不可用时，手工改为 DATA_MODE=hive 并重启 API；系统不会自动混用两个数据源。
HIVE_HOST=
HIVE_PORT=10000
HIVE_DATABASE=lywz
HIVE_USER=
HIVE_PASSWORD=
HIVE_AUTH=NONE
PROFIT_CACHE_TTL=300

# 风控Excel上传：上传后由独立Worker校验，并按出票票号增量合并到Hive目标表。
RISK_UPLOAD_ENABLED=true
# 可选：设置后，页面上传时必须输入相同口令。请只在真实.env中填写。
RISK_UPLOAD_TOKEN=
RISK_UPLOAD_MAX_MB=200
# WebHDFS高可用NameNode地址用分号分隔；文件正文会被重定向到DataNode HTTP端口。
RISK_UPLOAD_WEBHDFS_URL=http://t217:9870;http://t218:9870
RISK_UPLOAD_WEBHDFS_USER=lywz
# 测试环境不能解析生产主机名时填写；同时用于改写DataNode的9864重定向地址。
RISK_UPLOAD_WEBHDFS_HOST_MAP=
RISK_UPLOAD_WEBHDFS_CONNECT_TIMEOUT=10
RISK_UPLOAD_WEBHDFS_READ_TIMEOUT=300
RISK_UPLOAD_HDFS_URI=hdfs://mycluster
RISK_UPLOAD_HDFS_ROOT=/tmp/data-report/risk-uploads
RISK_UPLOAD_ORC_TIMEZONE=Asia/Shanghai
RISK_UPLOAD_POLL_SECONDS=2
