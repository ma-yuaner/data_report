HADOOP_CLIENT_CONF=/opt/ha/hadoop/etc/hadoop
HIVE_CLIENT_HOME=/opt/module/hive
HIVE_CLIENT_CONF=/opt/module/hive/conf
JAVA_CLIENT_HOME=/opt/module/jdk
HADOOP_PROBE_USER=lywz
HADOOP_PROBE_UID=1000
HADOOP_PROBE_GID=1000
HADOOP_PROBE_PATH=hdfs://mycluster/warehouse/lywz/ads/ads_gds_achievement_rate_day
